{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "electron"
    ],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "main.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "global.d.ts",
    "_electron_kit/**/*.ts"
  ]
}
