{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "electron"
    ],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "main.ts",
    "node/**/*.ts",
    "browser/**/*.ts",
    "global.d.ts",
    "..electron-kit/**/*.ts"
  ]
}
