{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "electron"],
    "noEmit": true
  },
  "include": [
    "node/**/*.ts",
    "browser/**/*.ts",
    "provider.ts",
    "electron-kit/**/*.ts"
  ]
}
